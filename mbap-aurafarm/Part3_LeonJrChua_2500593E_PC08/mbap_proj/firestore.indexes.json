{
  "indexes": [
    {
      "//": "profile screen: this user's cards, newest first",
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "//": "home feed, meme + likes band: two filters on different fields. an equality plus a range cannot use the automatic single-field indexes.",
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "memeName",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "likes",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "//": "profile stats: sum(likes) and average(likes) filtered by userId. aggregation queries need the aggregated field in the index too.",
      "collectionGroup": "posts",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "userId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "likes",
          "order": "ASCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": []
}
